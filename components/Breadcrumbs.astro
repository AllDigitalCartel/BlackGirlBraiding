---
/** Visible breadcrumbs. The matching BreadcrumbList JSON-LD is emitted by BaseLayout. */
const { items = [] } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <div class="container">
    <ol>
      <li><a href="/">Home</a></li>
      {items.map((c, i) =>
        i === items.length - 1
          ? <li><span aria-current="page">{c.name}</span></li>
          : <li><a href={c.href}>{c.name}</a></li>
      )}
    </ol>
  </div>
</nav>
